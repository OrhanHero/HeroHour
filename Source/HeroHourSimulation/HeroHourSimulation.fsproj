<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AssemblyName>HeroHourSimulation</AssemblyName>
    <RootNamespace>HeroHour.Simulation</RootNamespace>
    <!-- NOTE: TreatWarningsAsErrors intentionally disabled for now. The core
         is a work-in-progress; see ROADMAP.md. Re-enable once the codebase
         is warning-clean. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Only files that actually exist are referenced. The large module list
         previously here pointed at ~23 files that were never created, which is
         why the project could not build. Modules are added back as they are
         implemented (see ROADMAP.md). -->
    <Compile Include="src/Core/Constants.fs" />
    <Compile Include="src/Core/Types.fs" />
    <Compile Include="src/Core/GameState.fs" />
    <Compile Include="src/Core/GameCommand.fs" />
    <Compile Include="src/Core/SimulationResult.fs" />
    <Compile Include="src/Simulation.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Collections.Immutable" Version="8.0.0" />
  </ItemGroup>

</Project>
